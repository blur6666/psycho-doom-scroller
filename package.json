{
  "name": "webgl-modular-application",
  "version": "1.0.0",
  "description": "Modular WebGL application with shader transitions",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "npx rollup -c",
    "start": "npx serve -p 3000",
    "watch": "npx rollup -c -w",
    "dev": "npm run build && npm run start"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "rollup": "^2.79.1",
    "rollup-plugin-terser": "^7.0.2",
    "serve": "^14.2.4"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "jest-environment-jsdom",
    "moduleFileExtensions": [
      "js"
    ],
    "testMatch": [
      "**/test/unit/**/*.test.js"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/modules/**/*.js",
      "!src/modules/test/**/*"
    ]
  }
}
